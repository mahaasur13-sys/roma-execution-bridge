# ROMA Execution Bridge — Environment Variables
# Copy this file to .env and fill in your values.

# === STRIPE (Billing) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# === SLURM (HPC Integration) ===
SLURM_ENABLED=false
SLURM_HEAD_NODE=10.20.20.10
SLURM_USER=ubuntu
SLURM_SSH_KEY=/home/workspace/.ssh/slurm_key

# === STRIPE (Billing — Live Mode) ===
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get from: https://dashboard.stripe.com/webhooks (create endpoint for /webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Price IDs — create Products in Stripe Dashboard first
# https://dashboard.stripe.com/products
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# === OAUTH2 (Google + GitHub Login) ===
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Base URL for OAuth redirects (defaults to ROMA service URL)
OAUTH_REDIRECT_BASE=https://roma-execution-bridge-asurdev.zocomputer.io

# === SENDGRID (Email) ===
# Generate at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# Must be a verified sender in SendGrid
FROM_EMAIL=beta@roma-execution-bridge.io

# === GENERAL ===
ROMA_EXECUTION_MODE=local
PORT=8899
ANALYTICS_ENABLED=true
