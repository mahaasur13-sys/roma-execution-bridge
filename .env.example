# ROMA Execution Bridge — Environment Variables
# Copy this file to .env and fill in your values.

# === CLOUDPAYMENTS (Billing) ===
# Get from: https://my.cloudpayments.ru/ → Integration keys
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# Webhook secret — usually the same as API_SECRET
# Configure webhook URL in CloudPayments dashboard:
#   https://roma-execution-bridge-asurdev.zocomputer.io/webhooks/cloudpayments
CLOUDPAYMENTS_WEBHOOK_SECRET=

# === SLURM (HPC Integration) ===
SLURM_ENABLED=false
SLURM_HEAD_NODE=10.20.20.10
SLURM_USER=ubuntu
SLURM_SSH_KEY=/home/workspace/.ssh/slurm_key

# === CLOUDPAYMENTS (Billing) ===
# Get from: https://my.cloudpayments.ru/ → Integration keys
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# Webhook secret — usually the same as API_SECRET
# Configure webhook URL in CloudPayments dashboard:
#   https://roma-execution-bridge-asurdev.zocomputer.io/webhooks/cloudpayments
CLOUDPAYMENTS_WEBHOOK_SECRET=

# === OAUTH2 (Google + GitHub Login) ===
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Base URL for OAuth redirects (defaults to ROMA service URL)
OAUTH_REDIRECT_BASE=https://roma-execution-bridge-asurdev.zocomputer.io

# === SENDGRID (Email) ===
# Generate at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# Must be a verified sender in SendGrid
FROM_EMAIL=beta@roma-execution-bridge.io

# === GENERAL ===
ROMA_EXECUTION_MODE=local
PORT=8899
ANALYTICS_ENABLED=true
