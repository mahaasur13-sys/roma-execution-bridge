# DecisionOS Crypto Payments Configuration
CRYPTO_PROVIDER=nowpayments
CRYPTO_NOWPAYMENTS_API_KEY=your_api_key_here
CRYPTO_NOWPAYMENTS_IPN_SECRET=your_ipn_secret_here
CRYPTO_NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
CRYPTO_INVOICE_TTL_MINUTES=60
CRYPTO_MIN_CONFIRMATIONS=3
CRYPTO_RATE_LIMIT_INVOICES_PER_TENANT_PER_HOUR=10

# Wallet Management
CRYPTO_HELEKET_API_KEY=
CRYPTO_HELEKET_API_URL=https://api.heleket.com/v1
CRYPTO_CRYPTOCLOUD_API_KEY=
CRYPTO_CRYPTOCLOUD_API_URL=https://api.cryptocloud.plus/v2

# Monero Wallet RPC (view-only only — never store spend keys)
CRYPTO_MONERO_WALLET_RPC_URL=http://127.0.0.1:18084/json_rpc
CRYPTO_MONERO_DAEMON_RPC_URL=http://127.0.0.1:18081/json_rpc
CRYPTO_MONERO_VIEW_KEY=
CRYPTO_MONERO_PRIMARY_ADDRESS=
CRYPTO_MONERO_POLL_INTERVAL_SECONDS=30
CRYPTO_MONERO_MIN_CONFIRMATIONS=10
# SECURITY: DecisionOS NEVER stores Monero spend keys.
# Only view_key (private view key) is used for view-only wallet import.


# Support Chat
SUPPORT_MAX_MESSAGES_PER_TICKET=1000
SUPPORT_MAX_ATTACHMENTS_PER_MESSAGE=10
SUPPORT_MAX_ATTACHMENT_SIZE_MB=25
SUPPORT_AUTO_CLOSE_DAYS=7
SUPPORT_CSAT_REMINDER_HOURS=24
SUPPORT_WS_HEARTBEAT_SECONDS=30
SUPPORT_WS_MAX_CONNECTIONS_PER_TENANT=50
SUPPORT_NOTIFICATION_EMAIL_ENABLED=true
SUPPORT_NOTIFICATION_FROM_EMAIL=support@decisionos.io
